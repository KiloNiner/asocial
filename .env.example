# Path to the SQLite database file. Use a mounted volume in production.
DATABASE_PATH=./dev.db

# Public URL of the app; controls the Secure cookie flag and links in notifications.
APP_URL=http://localhost:3000

# Shared secret guarding POST /api/cron/run (header: x-cron-token).
CRON_SECRET=change-me

# Reference timezone for the server-side cron schedule.
TZ=Europe/Copenhagen

# SMTP settings for the email digest channel. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="asocial <noreply@example.com>"
# Set to "false" to accept a self-signed cert (e.g. a local Proton Mail Bridge
# or Mailhog container) while still using STARTTLS encryption. Leave unset/true
# for real mail providers.
SMTP_TLS_REJECT_UNAUTHORIZED=

# Single sign-on (OpenID Connect) — works with Pocket ID, Authentik, Keycloak,
# Authelia, Zitadel, ... Leave OIDC_ISSUER empty to disable. Redirect URI to
# register at the provider: $APP_URL/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Empty = public client (PKCE only).
OIDC_CLIENT_SECRET=
# Text on the login button ("Continue with ...").
OIDC_PROVIDER_NAME=
# OIDC_SCOPES="openid email profile"
# Create an account on first sign-in (default false: existing accounts only).
OIDC_AUTO_REGISTER=false
# Members of this provider group are admins (role is synced at every SSO
# sign-in; the last admin is never demoted). Adds the "groups" scope unless
# OIDC_SCOPES is set. OIDC_GROUPS_CLAIM names the claim (default "groups").
OIDC_ADMIN_GROUP=
# OIDC_GROUPS_CLAIM=groups
# Accept emails the provider has not marked verified (default false).
OIDC_TRUST_UNVERIFIED_EMAIL=false
# Set to "false" to hide the password form (only honoured while SSO is configured).
PASSWORD_LOGIN=true

# Test-only: freeze "today" (YYYY-MM-DD) for the scheduler. Leave empty in production.
FAKE_TODAY=
